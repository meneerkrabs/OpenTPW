# Retired fidelity IDs are a line list; a union merge keeps both branches' additions (the order is not checked).
tools/fidelity_retired.txt merge=union

# Shell scripts run under bash on every platform and a test parses this one: keep LF in a Windows checkout.
scripts/*.sh text eol=lf

# The shipped mods' identity (docs/MODS.md) is a hash of their bytes: keep LF in a Windows checkout so a park saved from one package loads in another.
content/mods/** text eol=lf

# Progress fragments must be LF (tools/progress.py checks it): keep LF in a Windows checkout.
docs/progress/*.md text eol=lf
