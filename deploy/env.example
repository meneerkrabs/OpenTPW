# Copy to .env beside compose.yml.
OPENTPW_DOMAIN=play.opentpw.io
OPENTPW_SERVER_NAME=OpenTPW
OPENTPW_MESSAGE=Welcome to the OpenTPW server. Be nice.
# latest follows releases; main follows every change on main.
OPENTPW_IMAGE_TAG=latest
# Secret a release uses to ask for an update; also the repository secret OPENTPW_DEPLOY_TOKEN.
# Generate with: openssl rand -hex 32. Empty disables release deployments.
OPENTPW_DEPLOY_TOKEN=
# Account e-mail (codes for new accounts and password recovery) through Resend. The API key is a secret:
# put it here only, never in the repository. REQUIRE_EMAIL=true needs the key and the sender.
OPENTPW_RESEND_API_KEY=
OPENTPW_EMAIL_FROM=OpenTPW <noreply@email.opentpw.io>
OPENTPW_EMAIL_REPLY_TO=contact@opentpw.io
OPENTPW_REQUIRE_EMAIL=false
