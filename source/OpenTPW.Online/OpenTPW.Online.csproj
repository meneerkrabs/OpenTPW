<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared online protocol: file formats, chat protocol, word filter and HTTP/WebSocket client. BCL only. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Required by the generated browser JavaScript interop stub. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>OpenTPW.Online</RootNamespace>
  </PropertyGroup>

</Project>
