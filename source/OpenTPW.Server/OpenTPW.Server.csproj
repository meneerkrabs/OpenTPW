<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Self-hostable OpenTPW online server: ASP.NET Core shared framework only, no NuGet packages. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OpenTPW.Server</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenTPW.Online\OpenTPW.Online.csproj" />
  </ItemGroup>

</Project>
