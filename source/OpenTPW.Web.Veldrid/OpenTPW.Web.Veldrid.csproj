<Project Sdk="Microsoft.NET.Sdk">

	<!--
	Veldrid's API, as far as OpenTPW uses it, implemented over WebGL2 for the browser build
	(docs/WEB.md). The desktop keeps the real Veldrid packages.
	-->
	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<LangVersion>preview</LangVersion>
	</PropertyGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
	</ItemGroup>

	<!-- One neutral input contract is shared by the shim and the browser game, not duplicated. -->
	<ItemGroup>
		<Compile Include="../OpenTPW.Common/Client/OrderedInputEvent.cs" Link="Input/OrderedInputEvent.cs" />
	</ItemGroup>

	<!-- Pure input-parser behavior tests; no browser or graphics initialization is required. -->
	<ItemGroup>
		<InternalsVisibleTo Include="OpenTPW.Tests" />
		<InternalsVisibleTo Include="OpenTPW.Web" />
	</ItemGroup>

</Project>
