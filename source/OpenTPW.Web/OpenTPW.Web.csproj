<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

	<!--
	The game in the browser (docs/WEB.md): the desktop sources compiled against OpenTPW.Web.Veldrid,
	a WebGL2 implementation of the Veldrid API the game uses. Files that only make sense on the
	desktop (SDL display queries, the native shader compiler, ImGui developer panels) are replaced
	by browser versions in this project or left out (the texture pack builder too: it needs native
	ONNX Runtime and an upscaler executable, and only runs from the desktop command line).
	-->
	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<OutputType>Exe</OutputType>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<LangVersion>preview</LangVersion>
		<!-- The settings files use reflection-based System.Text.Json, which trimming turns off by default. -->
		<JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
		<!-- Readable exception messages instead of resource keys. -->
		<UseSystemResourceKeys>false</UseSystemResourceKeys>
		<!-- The published page is compiled ahead of time (the server Dockerfile passes RunAOTCompilation=true with the
		wasm-tools workload; docs/BROWSER-PERFORMANCE.md). A plain local publish stays an interpreter build that needs no workload. -->
	</PropertyGroup>

	<PropertyGroup>
		<GameSources>../OpenTPW</GameSources>
		<CommonSources>../OpenTPW.Common</CommonSources>
		<FilesSources>../OpenTPW.Files</FilesSources>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="$(FilesSources)/**/*.cs" Exclude="$(FilesSources)/obj/**;$(FilesSources)/bin/**" Link="Files/%(RecursiveDir)%(Filename)%(Extension)" />
		<Compile Include="$(CommonSources)/**/*.cs" Exclude="$(CommonSources)/obj/**;$(CommonSources)/bin/**;$(CommonSources)/Client/SdlDisplay.cs" Link="Common/%(RecursiveDir)%(Filename)%(Extension)" />
		<Compile Include="$(GameSources)/**/*.cs" Link="Game/%(RecursiveDir)%(Filename)%(Extension)" Exclude="$(GameSources)/obj/**;$(GameSources)/bin/**;$(GameSources)/Formats/Model/**;&#xA;				$(GameSources)/Program.cs;&#xA;				$(GameSources)/Client/Game.cs;&#xA;				$(GameSources)/Client/TgqPngExport.cs;&#xA;				$(GameSources)/Client/SdtWavExport.cs;&#xA;				$(GameSources)/Client/LinuxNativeLibraries.cs;&#xA;				$(GameSources)/Render/Assets/TexturePackBuilder.cs;&#xA;				$(GameSources)/Render/Assets/ImagePrepass.cs;&#xA;				$(GameSources)/Render/ShaderCompiler.cs;&#xA;				$(GameSources)/Client/Setup/SetupWizard.cs;&#xA;				$(GameSources)/Client/Movie/SdlMovieAudioOutput.cs;&#xA;				$(GameSources)/Online/OnlinePanel.cs;&#xA;				$(GameSources)/UI/DisplaySettingsPanel.cs;&#xA;				$(GameSources)/UI/Layouts/ObjectBuildPanel.cs;&#xA;				$(GameSources)/UI/Layouts/ParkLayout.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Net.Codecrete.QrCodeGenerator" Version="3.2.1" />
		<ProjectReference Include="../OpenTPW.Web.Veldrid/OpenTPW.Web.Veldrid.csproj" />
		<ProjectReference Include="../OpenTPW.Online/OpenTPW.Online.csproj" />
		<PackageReference Include="SharpZipLib" Version="1.4.2" />
		<PackageReference Include="Zio" Version="0.22.2" />
		<PackageReference Include="StbImageSharp" Version="2.27.8" />
		<PackageReference Include="System.Configuration.ConfigurationManager" Version="6.0.0" />
	</ItemGroup>

	<!-- The content files the game reads, written to the in-memory file system at start (Program.Start). -->
	<ItemGroup>
		<EmbeddedResource Include="../../content/shaders/**/*" LogicalName="content/shaders/%(RecursiveDir)%(Filename)%(Extension)" />
		<EmbeddedResource Include="../../content/data/**/*" LogicalName="content/data/%(RecursiveDir)%(Filename)%(Extension)" />
		<!-- The data mods OpenTPW ships (docs/MODS.md): text only (manifest and objects.json), found by the mod discovery below the program folder like on the desktop. The example script mods (opentpw.example.*) stay out of the web build until the AOT check of script mods (docs/SCRIPT-MODS.md phase 5). -->
		<EmbeddedResource Include="../../content/mods/**/*" Exclude="../../content/mods/opentpw.example.*/**/*" LogicalName="content/mods/%(RecursiveDir)%(Filename)%(Extension)" />
		<!-- The pools extension's own content (docs/POOLS.md): the changing rooms and the other objects (objects.json and their archive folders) and the pinned sprite manifest (esprites.manifest.json: path, size and SHA-256 of every sprite file),
		     read from content/pools below the program folder like on the desktop. The sprite sets themselves (esprites/, about 8.8 MB: the 2x guests and swimwear) are NOT embedded: they would cost every browser user about 6.5 MB Brotli even with the
		     extension off. They are published as static files below pools-sprites/ (see below) and fetched in the background while the extension is on; the game keeps a file only when the manifest pins it (Browser delivery in docs/POOLS.md). -->
		<EmbeddedResource Include="../../content/pools/**/*" Exclude="../../content/pools/esprites/**/*" LogicalName="content/pools/%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<!-- The pools sprite sets as static files of the site (wwwroot/pools-sprites/..., the same origin as the page). The page fetches them after the start (wwwroot/opentpw-pool-sprites.js). -->
	<!-- Content linked into wwwroot becomes a static web asset: published (and served by the dev server) at pools-sprites/<path>, the same origin as the page. -->
	<ItemGroup>
		<Content Include="../../content/pools/esprites/**/*" Link="wwwroot/pools-sprites/%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<!-- The file system creates archive handlers by reflection; keep the game whole when trimming. -->
	<ItemGroup>
		<TrimmerRootAssembly Include="OpenTPW.Web" />
		<!-- The online API records are read and written by reflection-based System.Text.Json. -->
		<TrimmerRootAssembly Include="OpenTPW.Online" />
	</ItemGroup>

</Project>
