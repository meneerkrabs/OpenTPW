<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

	<!--
	The game in the browser (docs/WEB.md): the desktop sources compiled against OpenTPW.Web.Veldrid,
	a WebGL2 implementation of the Veldrid API the game uses. Files that only make sense on the
	desktop (SDL display queries, the native shader compiler, ImGui developer panels) are replaced
	by browser versions in this project or left out (the texture pack builder too: it needs native
	ONNX Runtime and an upscaler executable, and only runs from the desktop command line).
	-->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>Exe</OutputType>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<LangVersion>preview</LangVersion>
		<!-- The settings files use reflection-based System.Text.Json, which trimming turns off by default. -->
		<JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
		<!-- Readable exception messages instead of resource keys. -->
		<UseSystemResourceKeys>false</UseSystemResourceKeys>
		<!-- The published page is compiled ahead of time (the server Dockerfile passes RunAOTCompilation=true with the
		wasm-tools workload; docs/BROWSER-PERFORMANCE.md). A plain local publish stays an interpreter build that needs no workload. -->
	</PropertyGroup>

	<PropertyGroup>
		<GameSources>../OpenTPW</GameSources>
		<CommonSources>../OpenTPW.Common</CommonSources>
		<FilesSources>../OpenTPW.Files</FilesSources>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="$(FilesSources)/**/*.cs" Exclude="$(FilesSources)/obj/**;$(FilesSources)/bin/**" Link="Files/%(RecursiveDir)%(Filename)%(Extension)" />
		<Compile Include="$(CommonSources)/**/*.cs" Exclude="$(CommonSources)/obj/**;$(CommonSources)/bin/**;$(CommonSources)/Client/SdlDisplay.cs" Link="Common/%(RecursiveDir)%(Filename)%(Extension)" />
		<Compile Include="$(GameSources)/**/*.cs" Link="Game/%(RecursiveDir)%(Filename)%(Extension)" Exclude="$(GameSources)/obj/**;$(GameSources)/bin/**;$(GameSources)/Formats/Model/**;&#xA;				$(GameSources)/Program.cs;&#xA;				$(GameSources)/Client/Game.cs;&#xA;				$(GameSources)/Client/LinuxNativeLibraries.cs;&#xA;				$(GameSources)/Render/Assets/TexturePackBuilder.cs;&#xA;				$(GameSources)/Render/Assets/ImagePrepass.cs;&#xA;				$(GameSources)/Render/ShaderCompiler.cs;&#xA;				$(GameSources)/Client/Setup/SetupWizard.cs;&#xA;				$(GameSources)/Client/Movie/SdlMovieAudioOutput.cs;&#xA;				$(GameSources)/Online/OnlinePanel.cs;&#xA;				$(GameSources)/UI/DisplaySettingsPanel.cs;&#xA;				$(GameSources)/UI/Layouts/ObjectBuildPanel.cs;&#xA;				$(GameSources)/UI/Layouts/ParkLayout.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Net.Codecrete.QrCodeGenerator" Version="3.2.1" />
		<ProjectReference Include="../OpenTPW.Web.Veldrid/OpenTPW.Web.Veldrid.csproj" />
		<ProjectReference Include="../OpenTPW.Online/OpenTPW.Online.csproj" />
		<PackageReference Include="SharpZipLib" Version="1.4.2" />
		<PackageReference Include="Zio" Version="0.22.2" />
		<PackageReference Include="StbImageSharp" Version="2.27.8" />
		<PackageReference Include="System.Configuration.ConfigurationManager" Version="6.0.0" />
	</ItemGroup>

	<!-- The content files the game reads, written to the in-memory file system at start (Program.Start). -->
	<ItemGroup>
		<EmbeddedResource Include="../../content/shaders/**/*" LogicalName="content/shaders/%(RecursiveDir)%(Filename)%(Extension)" />
		<EmbeddedResource Include="../../content/data/**/*" LogicalName="content/data/%(RecursiveDir)%(Filename)%(Extension)" />
		<!-- The HD interface art (docs/TEXTURE-PACKS.md) is NOT embedded as the PNGs here: the browser ships the
		     predecoded RGBA siblings staged by the PredecodeHeroArt target below instead (~+1.7 MB for skipping
		     PNG decode on a first menu open; UiImages/Texture load them through PredecodedUiArt). Desktop builds
		     keep the PNGs, and the two representations never coexist in one build. -->
		<!-- The pinned index is small; PNGs arrive on demand from the texture CDN. -->
		<EmbeddedResource Include="../../content/texture-packs/clarity-enhanced/distribution.json" LogicalName="content/texture-packs/clarity-enhanced/distribution.json" Condition="Exists('../../content/texture-packs/clarity-enhanced/distribution.json')" />
	</ItemGroup>

	<!-- Stages the predecoded hero art the browser embeds instead of content/hero-art's PNGs. The generator
	     (tools/hero-art) always runs and rewrites only changed files, so additions, removals and content or
	     tool changes take effect on the next build without timestamp tracking; the staging directory lives
	     under obj, outside git. -->
	<PropertyGroup>
		<!-- Under obj (outside git), per configuration so Debug and Release each keep their own staged set.
		     BaseIntermediateOutputPath is used because this SDK only sets IntermediateOutputPath later in the build. -->
		<PredecodedHeroArtStaging>$(BaseIntermediateOutputPath)predecoded-hero-art/$(Configuration)/</PredecodedHeroArtStaging>
	</PropertyGroup>
	<Target Name="PredecodeHeroArt" BeforeTargets="AssignTargetPaths">
		<PropertyGroup>
			<!-- NetCoreRoot is set when dotnet drives the build; plain msbuild takes dotnet from PATH. -->
			<_PredecodeDotnet Condition="'$(NetCoreRoot)' != '' And Exists('$(NetCoreRoot)dotnet')">"$(NetCoreRoot)dotnet"</_PredecodeDotnet>
			<_PredecodeDotnet Condition="'$(_PredecodeDotnet)' == ''">dotnet</_PredecodeDotnet>
		</PropertyGroup>
		<MakeDir Directories="$(PredecodedHeroArtStaging)" />
		<Exec StandardOutputImportance="high" Command="$(_PredecodeDotnet) build &quot;$(MSBuildThisFileDirectory)../../tools/hero-art/PredecodeHeroArt.csproj&quot; -c $(Configuration) --nologo -v:quiet" />
		<Exec StandardOutputImportance="high" Command="$(_PredecodeDotnet) &quot;$(MSBuildThisFileDirectory)../../tools/hero-art/bin/$(Configuration)/net10.0/PredecodeHeroArt.dll&quot; --source &quot;$(MSBuildThisFileDirectory)../../content/hero-art&quot; --staging &quot;$(PredecodedHeroArtStaging.TrimEnd('/\'))&quot;" />
		<ItemGroup>
			<_PredecodedHeroArt Include="$(PredecodedHeroArtStaging)**/*" />
		</ItemGroup>
		<ItemGroup>
			<!-- Inside a target, an item's own metadata is not yet readable, so the logical names are attached in a second step. -->
			<_PredecodedHeroArt Update="@(_PredecodedHeroArt)" LogicalName="content/hero-art/%(RecursiveDir)%(Filename)%(Extension)" />
		</ItemGroup>
		<ItemGroup>
			<EmbeddedResource Include="@(_PredecodedHeroArt)" />
		</ItemGroup>
	</Target>

	<!-- The file system creates archive handlers by reflection; keep the game whole when trimming. -->
	<ItemGroup>
		<TrimmerRootAssembly Include="OpenTPW.Web" />
		<!-- The online API records are read and written by reflection-based System.Text.Json. -->
		<TrimmerRootAssembly Include="OpenTPW.Online" />
	</ItemGroup>

</Project>
