<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

	<!--
	The game in the browser (docs/WEB.md): the desktop sources compiled against OpenTPW.Web.Veldrid,
	a WebGL2 implementation of the Veldrid API the game uses. Files that only make sense on the
	desktop (SDL display queries, the native shader compiler, ImGui developer panels) are replaced
	by browser versions in this project or left out (the texture pack builder too: it needs native
	ONNX Runtime and an upscaler executable, and only runs from the desktop command line).
	-->
	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<OutputType>Exe</OutputType>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<LangVersion>preview</LangVersion>
		<DefineConstants>$(DefineConstants);OPENTPW_BROWSER</DefineConstants>
		<!-- The settings files use reflection-based System.Text.Json, which trimming turns off by default. -->
		<JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
		<!-- Readable exception messages instead of resource keys. -->
		<UseSystemResourceKeys>false</UseSystemResourceKeys>
		<!-- The published page is compiled ahead of time (the server Dockerfile passes RunAOTCompilation=true with the
		wasm-tools workload; docs/BROWSER-PERFORMANCE.md). A plain local publish stays an interpreter build that needs no workload. -->
	</PropertyGroup>

	<!-- [EXT:online-coop-snapshot-join] how the page was compiled, which the co-op join smoke's evidence names (docs/COOP.md, "The browser's join") -->
	<ItemGroup>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>OpenTpwBrowserCompilation</_Parameter1>
			<_Parameter2 Condition="'$(UseMonoRuntime)' == 'false'">coreclr</_Parameter2>
			<_Parameter2 Condition="'$(UseMonoRuntime)' != 'false' And '$(RunAOTCompilation)' == 'true'">aot</_Parameter2>
			<_Parameter2 Condition="'$(UseMonoRuntime)' != 'false' And '$(RunAOTCompilation)' != 'true'">interpreter</_Parameter2>
		</AssemblyAttribute>
	</ItemGroup>

	<PropertyGroup>
		<GameSources>../OpenTPW</GameSources>
		<CommonSources>../OpenTPW.Common</CommonSources>
		<FilesSources>../OpenTPW.Files</FilesSources>
	</PropertyGroup>

	<!-- Legacy user.config and its unused cursor/GameDir callers stay desktop-only; Browser/LegacySettings.cs
	     supplies the shared fallback API without System.Configuration. -->
	<ItemGroup>
		<Compile Include="$(FilesSources)/**/*.cs" Exclude="$(FilesSources)/obj/**;$(FilesSources)/bin/**" Link="Files/%(RecursiveDir)%(Filename)%(Extension)" />
		<Compile Include="$(CommonSources)/**/*.cs" Exclude="$(CommonSources)/obj/**;$(CommonSources)/bin/**;$(CommonSources)/Client/SdlDisplay.cs;$(CommonSources)/Client/OrderedInputEvent.cs" Link="Common/%(RecursiveDir)%(Filename)%(Extension)" />
		<Compile Include="$(GameSources)/**/*.cs" Link="Game/%(RecursiveDir)%(Filename)%(Extension)" Exclude="$(GameSources)/obj/**;$(GameSources)/bin/**;$(GameSources)/Formats/Model/**;&#xA;				$(GameSources)/Program.cs;&#xA;				$(GameSources)/Client/Game.cs;&#xA;				$(GameSources)/Client/GameDir.cs;&#xA;				$(GameSources)/Client/LegacySettings.cs;&#xA;				$(GameSources)/Settings.Designer.cs;&#xA;				$(GameSources)/UI/Cursor.cs;&#xA;				$(GameSources)/Client/TgqPngExport.cs;&#xA;				$(GameSources)/Client/SdtWavExport.cs;&#xA;				$(GameSources)/Client/SignExport.cs;&#xA;				$(GameSources)/Client/LinuxNativeLibraries.cs;&#xA;				$(GameSources)/Render/Assets/TexturePackBuilder.cs;&#xA;				$(GameSources)/Render/Assets/ImagePrepass.cs;&#xA;				$(GameSources)/Render/ShaderCompiler.cs;&#xA;				$(GameSources)/Render/Direct3D11Bytecode.cs;&#xA;				$(GameSources)/Client/Setup/SetupWizard.cs;&#xA;				$(GameSources)/Client/Movie/SdlMovieAudioOutput.cs;&#xA;				$(GameSources)/Online/OnlinePanel.cs;&#xA;				$(GameSources)/UI/DisplaySettingsPanel.cs;&#xA;				$(GameSources)/UI/Layouts/ObjectBuildPanel.cs;&#xA;				$(GameSources)/UI/Layouts/ParkLayout.cs" />
	</ItemGroup>

	<!--
	The cross-runtime determinism check (docs/DETERMINISM.md, "Browser and native"; tools/web-determinism): with
	-p:OpenTpwDeterminismPins=true the page also carries the asset-free unit tests that pin simulation digests, compiled into this
	same assembly with the same settings (AOT or interpreter) as the shipped page, and a JSExport that runs them. The published page
	never sets the property, so nothing of it ships.
	-->
	<PropertyGroup Condition="'$(OpenTpwDeterminismPins)' == 'true'">
		<DefineConstants>$(DefineConstants);OPENTPW_DETERMINISM_PINS</DefineConstants>
		<NoWarn>$(NoWarn);CS0618;CS8602;CS8604;CS8618;CS8625;CS0162;CS0219;CS0168;CS1998;CS8619;CS8620;CS8603;CS8600;CS8601;CS8629;CS0649;CS0169;CS0414</NoWarn>
	</PropertyGroup>
