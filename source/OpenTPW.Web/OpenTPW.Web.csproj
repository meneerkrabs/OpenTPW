	<ItemGroup Condition="'$(OpenTpwDeterminismPins)' == 'true'">
		<Compile Include="../OpenTPW.Tests/**/*.cs" Exclude="../OpenTPW.Tests/obj/**;../OpenTPW.Tests/bin/**;@(DeterminismPinsExcludedTests)" Link="Tests/%(RecursiveDir)%(Filename)%(Extension)" />
		<PackageReference Include="MSTest.TestFramework" Version="2.2.7" />
		<!-- the shipped example script mod, which the pinned script-mod run switches on (DeterminismTests.ScriptModsFixedRunHash) -->
		<EmbeddedResource Include="../../content/mods/opentpw.example.*/**/*" LogicalName="content/mods/%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>
	<ItemGroup Condition="'$(OpenTpwDeterminismPins)' != 'true'">
		<Compile Remove="Program.DeterminismPins.cs" />
		<Compile Remove="Program.ParticleRenderOracle.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Net.Codecrete.QrCodeGenerator" Version="3.2.1" />
		<ProjectReference Include="../OpenTPW.Web.Veldrid/OpenTPW.Web.Veldrid.csproj" />
		<ProjectReference Include="../OpenTPW.Online/OpenTPW.Online.csproj" />
		<PackageReference Include="SharpZipLib" Version="1.4.2" />
		<PackageReference Include="Zio" Version="0.22.2" />
		<PackageReference Include="StbImageSharp" Version="2.27.8" />
	</ItemGroup>

	<!-- The content files the game reads, written to the in-memory file system at start (Program.Start). -->
	<ItemGroup>
		<EmbeddedResource Include="../../content/shaders/**/*" LogicalName="content/shaders/%(RecursiveDir)%(Filename)%(Extension)" />
		<EmbeddedResource Include="../../content/data/**/*" LogicalName="content/data/%(RecursiveDir)%(Filename)%(Extension)" />
		<!-- The data mods OpenTPW ships (docs/MODS.md): text only (manifest and objects.json), found by the mod discovery below the program folder like on the desktop. The example script mods (opentpw.example.*) stay out of the web build until the AOT check of script mods (docs/SCRIPT-MODS.md phase 5). -->
		<EmbeddedResource Include="../../content/mods/**/*" Exclude="../../content/mods/opentpw.example.*/**/*" LogicalName="content/mods/%(RecursiveDir)%(Filename)%(Extension)" />
		<!-- The pools extension's own content (docs/POOLS.md): the changing rooms and the other objects (objects.json and their archive folders) and the pinned sprite manifest (esprites.manifest.json: path, size and SHA-256 of every sprite file),
		     read from content/pools below the program folder like on the desktop. The sprite sets themselves (esprites/, about 8.8 MB: the 2x guests and swimwear) are NOT embedded: they would cost every browser user about 6.5 MB Brotli even with the
		     extension off. They are published as static files below pools-sprites/ (see below) and fetched in the background while the extension is on; the game keeps a file only when the manifest pins it (Browser delivery in docs/POOLS.md). -->
		<EmbeddedResource Include="../../content/pools/**/*" Exclude="../../content/pools/esprites/**/*" LogicalName="content/pools/%(RecursiveDir)%(Filename)%(Extension)" />
		<!-- The umbrellas extension's own content (docs/UMBRELLAS.md): the four brolly shops, the umbrella sprite set (29 KB, so it is embedded rather than fetched like the pools' sprites) and the hand anchor tables, read from content/umbrellas
		     below the program folder like on the desktop. -->
		<EmbeddedResource Include="../../content/umbrellas/**/*" LogicalName="content/umbrellas/%(RecursiveDir)%(Filename)%(Extension)" />
		<!-- The winter extension's own content (docs/WINTER.md): the eight winter shops, the warm item sprite set (23 KB) and the anchor tables (the 2x kids' 108 KB and the original sets' head-only 19 KB), read from content/winter below the program
		     folder like on the desktop. 1,322,442 bytes, about 406 KB deflated per file; downloaded also with the extension off. -->
		<EmbeddedResource Include="../../content/winter/**/*" LogicalName="content/winter/%(RecursiveDir)%(Filename)%(Extension)" />
		<!-- The evening extension's own content (docs/EVENING.md, "Torches"): the four torches (objects.json and their archive folders, 347,862 bytes), read from content/evening below the program folder like on the desktop. -->
		<EmbeddedResource Include="../../content/evening/**/*" LogicalName="content/evening/%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<!-- A wildcard over a folder that is missing (a build context that does not copy it, as the server image's once did for umbrellas and winter) embeds nothing and still builds: the page then ships without the
	     extension's shops. Fail the build instead. -->
	<Target Name="RequireExtensionContent" BeforeTargets="BeforeBuild">
		<Error Condition="!Exists('../../content/pools/objects.json')" Text="content/pools/objects.json is missing: the browser page would ship without the pools extension's objects." />
		<Error Condition="!Exists('../../content/umbrellas/objects.json')" Text="content/umbrellas/objects.json is missing: the browser page would ship without the brolly shops." />
		<Error Condition="!Exists('../../content/winter/objects.json')" Text="content/winter/objects.json is missing: the browser page would ship without the winter shops." />
		<Error Condition="!Exists('../../content/evening/objects.json')" Text="content/evening/objects.json is missing: the browser page would ship without the evening extension's torches." />
	</Target>

	<!-- The pools sprite sets as static files of the site (wwwroot/pools-sprites/..., the same origin as the page). The page fetches them after the start (wwwroot/opentpw-pool-sprites.js). -->
	<!-- Content linked into wwwroot becomes a static web asset: published (and served by the dev server) at pools-sprites/<path>, the same origin as the page. -->
	<ItemGroup>
		<Content Include="../../content/pools/esprites/**/*" Link="wwwroot/pools-sprites/%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<!-- The publish step stores a Brotli and a gzip copy of the files it knows to be compressible (js, css, json, wasm, dat, ...); the 8.2 MB of sprite files (.TPC, about 36 % smaller with Brotli) are not on its list, so they
	     went out as they were. The server sends the copy the browser accepts (OpenTPW.Server/WebClient.cs). The 350-byte .ESP files stay as they are. -->
	<PropertyGroup>
		<CompressionIncludePatterns>$(CompressionIncludePatterns);**/*.TPC;**/*.tpc</CompressionIncludePatterns>
	</PropertyGroup>

	<!-- The file system creates archive handlers by reflection; keep the game whole when trimming. -->
	<ItemGroup>
		<TrimmerRootAssembly Include="OpenTPW.Web" />
		<!-- The online API records are read and written by reflection-based System.Text.Json. -->
		<TrimmerRootAssembly Include="OpenTPW.Online" />
	</ItemGroup>

</Project>
