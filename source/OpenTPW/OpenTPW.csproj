<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<ApplicationIcon>icon.ico</ApplicationIcon>
		<LangVersion>preview</LangVersion>
		<ApplicationManifest>app.manifest</ApplicationManifest>
	</PropertyGroup>

	<ItemGroup>
	  <Compile Remove="Formats\Model\**" />
	  <EmbeddedResource Remove="Formats\Model\**" />
	  <None Remove="Formats\Model\**" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="icon.ico" />
		<Content Include="../../content/**/*" Link="content/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup Condition="'$(RuntimeIdentifier)' == 'osx-arm64' Or '$(RuntimeIdentifier)' == 'osx-x64' Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('OSX')))">
		<Content Include="$(NuGetPackageRoot)imgui.net/1.87.2/runtimes/osx-universal/native/libcimgui.dylib" Link="libcimgui.dylib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

	<PropertyGroup Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">
		<SDL2NativePath Condition="'$(SDL2NativePath)' == ''">/opt/homebrew/lib/libSDL2.dylib</SDL2NativePath>
	</PropertyGroup>
	<ItemGroup Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">
		<Content Include="../../native/osx-arm64/libveldrid-spirv.dylib" Link="libveldrid-spirv.dylib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<Content Include="$(SDL2NativePath)" Link="libsdl2.dylib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>
	<Target Name="ValidateMacOSArm64Libraries" BeforeTargets="Build" Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">
		<Error Condition="!Exists('../../native/osx-arm64/libveldrid-spirv.dylib')" Text="Build the existing SPIR-V dependency first with scripts/build-macos-native.sh." />
		<Error Condition="!Exists('$(SDL2NativePath)')" Text="Set SDL2NativePath to an existing arm64 SDL2 dylib. See docs/MACOS-NATIVE.md." />
	</Target>

	<ItemGroup>
		<PackageReference Include="ImGui.NET" Version="1.87.2" />
		<PackageReference Include="NAudio" Version="2.2.1" />
		<PackageReference Include="SharpText.Veldrid" Version="0.3.1" />
		<PackageReference Include="SharpZipLib" Version="1.4.2" />
		<PackageReference Include="StbImageSharp" Version="2.27.8" />
		<PackageReference Include="System.Configuration.ConfigurationManager" Version="6.0.0" />
		<PackageReference Include="Veldrid" Version="4.9.0" />
		<PackageReference Include="Veldrid.ImGui" Version="5.72.0" />
		<PackageReference Include="Veldrid.SDL2" Version="4.8.0" />
		<PackageReference Include="Veldrid.SPIRV" Version="1.0.14" />
		<PackageReference Include="Veldrid.StartupUtilities" Version="4.8.0" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\OpenTPW.Online\OpenTPW.Online.csproj" />
	  <ProjectReference Include="..\OpenTPW.Common\OpenTPW.Common.csproj" />
	  <ProjectReference Include="..\OpenTPW.Files\OpenTPW.Files.csproj" />
	  <ProjectReference Include="..\OpenTPW.ModKit\OpenTPW.ModKit.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Settings.Designer.cs">
			<DesignTimeSharedInput>True</DesignTimeSharedInput>
			<AutoGen>True</AutoGen>
			<DependentUpon>Settings.settings</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<None Update="Settings.settings">
			<Generator>SettingsSingleFileGenerator</Generator>
			<LastGenOutput>Settings.Designer.cs</LastGenOutput>
		</None>
	</ItemGroup>

</Project>
