<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<ApplicationIcon>icon.ico</ApplicationIcon>
		<LangVersion>preview</LangVersion>
		<ApplicationManifest>app.manifest</ApplicationManifest>
	</PropertyGroup>

	<ItemGroup>
	  <Compile Remove="Formats\Model\**" />
	  <EmbeddedResource Remove="Formats\Model\**" />
	  <None Remove="Formats\Model\**" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="icon.ico" />
		<Content Include="../../content/**/*" Link="content/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup Condition="'$(RuntimeIdentifier)' == 'osx-arm64' Or '$(RuntimeIdentifier)' == 'osx-x64' Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('OSX')))">
		<Content Include="$(NuGetPackageRoot)imgui.net/1.87.2/runtimes/osx-universal/native/libcimgui.dylib" Link="libcimgui.dylib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

	<!-- Native libraries the pinned packages do not ship for this runtime, built by scripts/build-native.py (docs/RELEASES.md) -->
	<PropertyGroup>
		<NativeRuntimeDirectory>$(MSBuildThisFileDirectory)../../native/$(RuntimeIdentifier)/</NativeRuntimeDirectory>
	</PropertyGroup>
	<ItemGroup Condition="'$(RuntimeIdentifier)' != '' And Exists('$(NativeRuntimeDirectory)')">
		<Content Include="$(NativeRuntimeDirectory)*" Exclude="$(NativeRuntimeDirectory).*" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

	<!-- Local arm64 macOS builds without a built SDL2 fall back to Homebrew's -->
	<PropertyGroup Condition="'$(RuntimeIdentifier)' == 'osx-arm64' And !Exists('$(NativeRuntimeDirectory)libsdl2.dylib')">
		<SDL2NativePath Condition="'$(SDL2NativePath)' == ''">/opt/homebrew/lib/libSDL2.dylib</SDL2NativePath>
		<!-- Homebrew's sdl2 is now sdl2-compat, which loads SDL3 from beside itself at startup -->
		<SDL3NativePath Condition="'$(SDL3NativePath)' == '' And Exists('/opt/homebrew/lib/libSDL3.0.dylib')">/opt/homebrew/lib/libSDL3.0.dylib</SDL3NativePath>
	</PropertyGroup>
	<ItemGroup Condition="'$(RuntimeIdentifier)' == 'osx-arm64' And '$(SDL2NativePath)' != ''">
		<Content Include="$(SDL2NativePath)" Link="libsdl2.dylib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<Content Include="$(SDL3NativePath)" Condition="'$(SDL3NativePath)' != '' And Exists('$(SDL3NativePath)')" Link="libSDL3.dylib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

	<Target Name="ValidateNativeLibraries" BeforeTargets="Build" Condition="'$(RuntimeIdentifier)' == 'osx-arm64' Or '$(RuntimeIdentifier)' == 'win-arm64' Or '$(RuntimeIdentifier)' == 'linux-arm64'">
		<PropertyGroup>
			<NativeBuildHint>Build it with: python3 scripts/build-native.py --rid $(RuntimeIdentifier) (see docs/RELEASES.md).</NativeBuildHint>
		</PropertyGroup>
		<Error Condition="'$(RuntimeIdentifier)' == 'osx-arm64' And !Exists('$(NativeRuntimeDirectory)libveldrid-spirv.dylib')" Text="native/osx-arm64/libveldrid-spirv.dylib is missing. $(NativeBuildHint)" />
		<Error Condition="'$(RuntimeIdentifier)' == 'osx-arm64' And !Exists('$(NativeRuntimeDirectory)libsdl2.dylib') And !Exists('$(SDL2NativePath)')" Text="No arm64 SDL2: build native/osx-arm64/libsdl2.dylib or set SDL2NativePath (docs/MACOS-NATIVE.md). $(NativeBuildHint)" />
		<Error Condition="'$(RuntimeIdentifier)' == 'win-arm64' And (!Exists('$(NativeRuntimeDirectory)libveldrid-spirv.dll') Or !Exists('$(NativeRuntimeDirectory)cimgui.dll') Or !Exists('$(NativeRuntimeDirectory)SDL2.dll'))" Text="native/win-arm64 needs libveldrid-spirv.dll, cimgui.dll and SDL2.dll. $(NativeBuildHint)" />
		<Error Condition="'$(RuntimeIdentifier)' == 'linux-arm64' And (!Exists('$(NativeRuntimeDirectory)libveldrid-spirv.so') Or !Exists('$(NativeRuntimeDirectory)libcimgui.so'))" Text="native/linux-arm64 needs libveldrid-spirv.so and libcimgui.so. $(NativeBuildHint)" />
	</Target>

	<ItemGroup>
		<PackageReference Include="ImGui.NET" Version="1.87.2" />
		<PackageReference Include="NAudio" Version="2.2.1" />
		<PackageReference Include="SharpText.Veldrid" Version="0.3.1" />
		<PackageReference Include="SharpZipLib" Version="1.4.2" />
		<PackageReference Include="StbImageSharp" Version="2.27.8" />
		<PackageReference Include="System.Configuration.ConfigurationManager" Version="6.0.0" />
		<PackageReference Include="Veldrid" Version="4.9.0" />
		<PackageReference Include="Veldrid.ImGui" Version="5.72.0" />
		<PackageReference Include="Veldrid.SDL2" Version="4.8.0" />
		<PackageReference Include="Veldrid.SPIRV" Version="1.0.14" />
		<PackageReference Include="Veldrid.StartupUtilities" Version="4.8.0" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\OpenTPW.Online\OpenTPW.Online.csproj" />
	  <ProjectReference Include="..\OpenTPW.Common\OpenTPW.Common.csproj" />
	  <ProjectReference Include="..\OpenTPW.Files\OpenTPW.Files.csproj" />
	  <ProjectReference Include="..\OpenTPW.ModKit\OpenTPW.ModKit.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Settings.Designer.cs">
			<DesignTimeSharedInput>True</DesignTimeSharedInput>
			<AutoGen>True</AutoGen>
			<DependentUpon>Settings.settings</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<None Update="Settings.settings">
			<Generator>SettingsSingleFileGenerator</Generator>
			<LastGenOutput>Settings.Designer.cs</LastGenOutput>
		</None>
	</ItemGroup>

</Project>
