; Placeholder script of the pool water attractions (OpenTPW swimming pools: rope swing, water jets, wave machine, spa).
; These objects are not rides: no guest is ever sent in (Info.IsChoosable 0, no queue, no entrance), so the script only has to exist and be valid.
; It idles forever; the pool code animates and uses the object itself.
.stack 4
.timeslice 50
.limbo 0
.bounce 0
.walk 0

.var VAR_LETMEON
.var VAR_LETMEOFF
.var VAR_CAPACITY
.var VAR_DURATION
.var VAR_BREAKSTAT
.var VAR_ONRIDE
.var VAR_RIDECLOSED
.var VAR_BROKEN
.var VAR_WORN
.var VAR_RUNNING
.var VAR_PAD
.var VAR_PARAM
.var VAR_SPACELEFT

	NAME "Pool Attraction"
idle:
	ENDSLICE
	BRANCH @idle
