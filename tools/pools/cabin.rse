; Changing room ride script (OpenTPW swimming pools).
; Guests go in and stay hidden: there are no head records and no ADDHEAD, so nobody is drawn while changing.
; The fill loop waits up to 1.5 seconds for the next guest (the kit's placeholder waits 10), then the cabin waits 3 seconds more (the changing
; time), releases everybody one by one and the pool code takes them swimming.
; The stack size is also the size of the HUSH/HOP heap that holds the riders' ids: it must be at least the capacity.
.stack 20
.timeslice 50
.limbo 0
.bounce 0
.walk 0

.var VAR_LETMEON
.var VAR_LETMEOFF
.var VAR_CAPACITY
.var VAR_DURATION
.var VAR_BREAKSTAT
.var VAR_ONRIDE
.var VAR_RIDECLOSED
.var VAR_BROKEN
.var VAR_WORN
.var VAR_RUNNING
.var VAR_PAD
.var VAR_PARAM
.var VAR_SPACELEFT

	NAME "Changing Room"
closed:
	ENDSLICE
	TEST VAR_RIDECLOSED
	BRANCH_NZ @closed
fill:
	SETTIMER 1500
	COPY VAR_SPACELEFT VAR_CAPACITY
take:
	TEST VAR_SPACELEFT
	BRANCH_Z @change
	TEST VAR_RIDECLOSED
	BRANCH_NZ @unload
	GETTIMER 1500
	BRANCH_Z @change
	CRIT_LOCK
	TEST VAR_LETMEON
	BRANCH_Z @nobody
	SETTIMER 1500
	HUSH VAR_LETMEON
	COPY VAR_LETMEON 0
	ADD VAR_ONRIDE 1
	ADD VAR_SPACELEFT 0xFFFF
	BRANCH_Z @full
nobody:
	CRIT_UNLOCK
	BRANCH @take
full:
	CRIT_UNLOCK
change:
	TEST VAR_ONRIDE
	BRANCH_Z @unload
	COPY VAR_RUNNING 1
	WAIT 3000
unload:
	COPY VAR_RUNNING 0
leave:
	TEST VAR_ONRIDE
	BRANCH_Z @done
	CRIT_LOCK
	HOP VAR_LETMEOFF
	CRIT_UNLOCK
taken:
	TEST VAR_LETMEOFF
	BRANCH_NZ @taken
	ADD VAR_ONRIDE 0xFFFF
	WAIT 300
	BRANCH_NZ @leave
done:
	TEST VAR_RIDECLOSED
	BRANCH_NZ @closed
	BRANCH @fill
