<Project Sdk="Microsoft.NET.Sdk">

	<!--
		Evaluates OpenTPW's own implementation of the oracle targets on JSON-lines input (docs/reverse/ORACLE.md).
		Only main's public or existing seams are called; nothing here reimplements a rule. EconomyTestData supplies
		synthetic balance settings (no original data).
	-->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net11.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsPackable>false</IsPackable>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="../../../../source/OpenTPW/OpenTPW.csproj" />
		<Compile Include="../../../../source/OpenTPW.Tests/EconomyTestData.cs" Link="EconomyTestData.cs" />
	</ItemGroup>

</Project>
